{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "isolatedDeclarations": true,
        "rootDir": "src",
        "outDir": "dist",
        "lib": ["ES2022"],
        "types": []
    },
    "include": ["src"],
    "exclude": [
        "**/*.spec.ts",
        "**/__fixtures__/*",
        "**/__tests__/*",
        "**/__snapshots__/*"
    ]
}
